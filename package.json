{
  "name": "xiaoqing-ledger",
  "version": "1.0.3",
  "scripts": {
    "dev:mp-weixin": "node scripts/prepare-local-config.cjs && uni -p mp-weixin",
    "build:mp-weixin": "node scripts/prepare-local-config.cjs && uni build -p mp-weixin && node scripts/check-mp-quality.cjs",
    "upload:mp-weixin": "node scripts/upload-mp-weixin.cjs",
    "dev:h5": "node scripts/prepare-local-config.cjs && uni --host 127.0.0.1",
    "build:h5": "node scripts/prepare-local-config.cjs && uni build",
    "type-check": "node scripts/prepare-local-config.cjs && vue-tsc --noEmit",
    "test": "node scripts/build-cloud.cjs && node tests/version.test.cjs && node tests/upload-mp-weixin.test.cjs && node tests/ledger.test.cjs && node tests/insights.test.cjs && node tests/ui-features.test.cjs && node tests/cloud.test.cjs && node tests/auth.test.cjs && node tests/auth-persistence.test.cjs && node tests/features.test.cjs && node tests/desktop-auth.test.cjs && node tests/desktop-gateway.test.cjs",
    "test:version": "node tests/version.test.cjs && node tests/upload-mp-weixin.test.cjs",
    "build:cloud": "node scripts/prepare-local-config.cjs && node scripts/build-cloud.cjs",
    "check:mp-quality": "node scripts/check-mp-quality.cjs",
    "setup:local": "node scripts/prepare-local-config.cjs",
    "build:desktop-gateway": "node scripts/build-desktop-gateway.cjs",
    "build:desktop-ui": "vite build --config desktop/vite.config.cjs",
    "desktop": "node scripts/prepare-desktop.cjs && vite build --config desktop/vite.config.cjs && electron desktop/main.cjs",
    "package:desktop": "node scripts/prepare-desktop.cjs && vite build --config desktop/vite.config.cjs && electron-builder --win nsis"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020620260917001",
    "@dcloudio/uni-components": "3.0.0-5020620260917001",
    "@dcloudio/uni-h5": "3.0.0-5020620260917001",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020620260917001",
    "vue": "^3.4.21",
    "vue-i18n": "^9.1.9"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-automator": "3.0.0-5020620260917001",
    "@dcloudio/uni-cli-shared": "3.0.0-5020620260917001",
    "@dcloudio/uni-stacktracey": "3.0.0-5020620260917001",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020620260917001",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/runtime-core": "^3.4.21",
    "@vue/tsconfig": "^0.1.3",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "^4.9.4",
    "vite": "5.2.8",
    "vue-tsc": "^1.0.24"
  },
  "private": true,
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.xiaoqing.ledger",
    "productName": "小青账本",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/config.local.json",
      "dist/desktop-ui/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "description": "小青账本桌面版",
  "author": "Xiaoqing Ledger"
}
