# Copy to .env.local and fill in your own deployment identifiers.
# Never put AppSecret, access tokens or service credentials in client configuration.
XQ_APP_ID=
XQ_CLOUD_ENV=
# Public HTTPS URL of the separately deployed desktop gateway; no secrets in this file.
XQ_DESKTOP_API_URL=

# Mini program code version for QR sign-in: release, trial, or develop.
XQ_MINI_ENV=release
